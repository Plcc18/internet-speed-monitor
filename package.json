{
  "name": "internet-speed-monitor",
  "productName": "Internet Speed Monitor",
  "version": "1.0.0",
  "description": "Medidor de velocidade de internet com interface premium para Windows",
  "main": "electron/main.js",
  "author": {
    "name": "Pedro Lucas"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "engine-test": "node tools/cli-test.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pedrolucas.internetspeedmonitor",
    "productName": "Internet Speed Monitor",
    "copyright": "Copyright (c) 2026 Pedro Lucas",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Internet-Speed-Monitor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Internet Speed Monitor",
      "uninstallDisplayName": "Internet Speed Monitor",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Internet-Speed-Monitor-Portable-${version}.${ext}"
    }
  }
}
